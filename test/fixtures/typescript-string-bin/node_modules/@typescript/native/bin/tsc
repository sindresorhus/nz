// The `bin` in the package.json is a string, which npm allows for a package with one binary, and it is the path the tool has to use.
// It reports only the error in the type check file, which is the last file on the command line, so the run counts as type checked.
process.stdout.write(`${process.argv.at(-1)}(2,7): error TS2322: Type 'number' is not assignable to type 'string'.\n`);
